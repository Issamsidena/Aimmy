<Window x:Class="Visuality.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:theme="clr-namespace:Aimmy2.Theme"
        theme:ThemeBehavior.AutoRegister="True"
        Title="Aimmy"
        Height="400"
        Width="340"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">
    <Border x:Name="MainBorder"
            CornerRadius="5"
            BorderBrush="Black"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0">
                <GradientStop Color="Black" Offset="0.27" />
                <GradientStop x:Name="ThemeGradientStop" Color="#FF120338" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid x:Name="Topbar" VerticalAlignment="Top" Height="50">
                <Label Content="&#xE74E;"
                       HorizontalAlignment="Left"
                       Margin="15,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#DDFFFFFF"
                       Padding="0"
                       FontSize="14"
                       FontFamily="Segoe MDL2 Assets" />
                <Label Content="Aimmy (AI View)"
                       HorizontalAlignment="Left"
                       Margin="38,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#DDFFFFFF"
                       Padding="0"
                       FontSize="14" />
                <Button x:Name="Exit"
                        Content="&#xE8BB;"
                        HorizontalAlignment="Right"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        Foreground="White"
                        FontFamily="Segoe MDL2 Assets"
                        Padding="15,0,15,0"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderThickness="0"
                        FontSize="10"
                        VerticalAlignment="Center"
                        Click="Exit_Click" />
            </Grid>
            <Grid x:Name="MainArea" Margin="10,50,10,10">
                <Image x:Name="CaptureImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="EmptyHint"
                           Text="Waiting for capture… (aim/detection must be active)"
                           Foreground="#888888"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16" />
                <TextBlock x:Name="FpsText"
                           Text="FPS: 0"
                           Foreground="#FF3B30"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="4" />
            </Grid>
        </Grid>
    </Border>
</Window>
