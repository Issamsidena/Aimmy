<Window x:Class="Visuality.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:theme="clr-namespace:Aimmy2.Theme"
        theme:ThemeBehavior.AutoRegister="True"
        Title="Aimmy"
        Height="400"
        Width="340"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">
    <Border x:Name="MainBorder"
            CornerRadius="5"
            BorderBrush="Black"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0">
                <GradientStop Color="Black" Offset="0.27" />
                <GradientStop x:Name="ThemeGradientStop" Color="#FF120338" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid x:Name="Topbar" VerticalAlignment="Top" Height="50">
                <Path Fill="White"
                      StrokeThickness="1.33333"
                      Stretch="Fill"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Width="20"
                      Height="10"
                      Margin="15,0,0,0">
                    <Path.Data>
                        <PathGeometry Figures="M 18.2472,490.72756 0.18686636,472.66723 153.0173,318.84293 305.84774,165.01862 l 17.74245,17.70593 17.74244,17.70592 17.0189,-16.98112 c 9.36039,-9.33961 17.60957,-16.98112 18.33151,-16.98112 0.72194,0 69.86022,68.54563 153.64061,152.32363 l 152.32798,152.32362 -18.32581,18.45368 -18.3258,18.45368 -152.3021,-153.11064 -152.3021,-153.11063 -20.36457,20.6423 C 309.83073,233.79713 241.18587,302.86906 168.4871,375.93703 L 36.307534,508.7879 Z"
                                      FillRule="NonZero" />
                    </Path.Data>
                </Path>
                <Label Content="Aimmy (AI View)"
                       HorizontalAlignment="Left"
                       Margin="45,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#DDFFFFFF"
                       Padding="0"
                       FontSize="14" />
                <Button x:Name="Exit"
                        Content="&#xE8BB;"
                        HorizontalAlignment="Right"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        Foreground="White"
                        FontFamily="Segoe MDL2 Assets"
                        Padding="15,0,15,0"
                        materialDesign:ButtonAssist.CornerRadius="5"
                        BorderThickness="0"
                        FontSize="10"
                        VerticalAlignment="Center"
                        Click="Exit_Click" />
            </Grid>
            <Grid x:Name="MainArea" Margin="10,50,10,10">
                <Image x:Name="CaptureImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="EmptyHint"
                           Text="Waiting for capture… (aim/detection must be active)"
                           Foreground="#888888"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16" />
                <TextBlock x:Name="FpsText"
                           Text="FPS: 0"
                           Foreground="#FF3B30"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="6,10,6,6" />
            </Grid>
        </Grid>
    </Border>
</Window>
