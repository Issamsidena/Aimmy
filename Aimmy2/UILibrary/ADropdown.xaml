<UserControl x:Class="UILibrary.ADropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Ant="clr-namespace:AntWpf.Controls;assembly=AntWpf"
             xmlns:local="clr-namespace:UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             Height="80">
    <UserControl.Resources>
        <!-- Popup rows (light panel): dark text, bullet dot + highlight band on the selected item -->
        <Style x:Key="ADropdownItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FF202020" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Bullet"
                                         Grid.Column="0"
                                         Width="6"
                                         Height="6"
                                         Fill="#FF202020"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#19000000" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#28000000" />
                                <Setter TargetName="Bullet" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ADropdownComboStyle" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ADropdownItemStyle}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Native ToggleButton drives open + selection. Style="{x:Null}" clears the
                                 implicit theme style that was preventing it from stretching to full width. -->
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{x:Null}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#3F3C3C3C"
                                                BorderBrush="#3FFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#DDFFFFFF" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Selected text overlaid on the left; not hit-testable so the button gets clicks -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <!-- Open popup: light rounded panel (matches reference image) -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,8,12"
                                        CornerRadius="8"
                                        Background="#FFEDEDE9"
                                        BorderBrush="#FF9A9A9A"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000"
                                                          BlurRadius="14"
                                                          ShadowDepth="3"
                                                          Opacity="0.45" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Height="80"
                Background="#3F3C3C3C"
                CornerRadius="00"
                BorderThickness="1,0,1,0"
                BorderBrush="#3FFFFFFF">
            <Grid>
                <Label x:Name="DropdownTitle"
                       Padding="10,10,10,10"
                       FontFamily="{StaticResource Atkinson Hyperlegible}"
                       Content="Prediction Method"
                       Foreground="#DDFFFFFF"
                       VerticalContentAlignment="Center"
                       FontSize="13"
                       VerticalAlignment="Top"
                       Height="40" />
                <ComboBox x:Name="DropdownBox"
                          Height="30"
                          Margin="10,0,10,10"
                          VerticalAlignment="Bottom"
                          Foreground="White"
                          Ant:Input.PlaceholderBrush="#FFC8C8C8"
                          BorderBrush="#3FFFFFFF"
                          Padding="5,0,5,0"
                          BorderThickness="1,1,1,1"
                          Background="{x:Null}"
                          SelectedIndex="0"
                          Style="{StaticResource ADropdownComboStyle}"
                          FontFamily="{StaticResource Atkinson Hyperlegible}"
                          SelectionChanged="DropdownBox_SelectionChanged"
                          DropDownOpened="DropdownBox_DropDownOpened">
                </ComboBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
