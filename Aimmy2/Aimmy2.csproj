  <!--
    Ensure onnxruntime.dll / onnxruntime_providers_shared.dll / DirectML.dll
    sit next to YmmiaV2.exe AND that the runtimes\win-x64\native\ folder is
    also produced — for every Platform/Configuration (AnyCPU, x64, Debug,
    Release). NuGet's default targets only copy native DLLs when a
    RuntimeIdentifier is set; this Target makes the copy unconditional.
  -->
  <Target Name="CopyOnnxRuntimeNativeDlls" AfterTargets="Build">
    <ItemGroup>
      <_OnnxNative Include="$(PkgMicrosoft_ML_OnnxRuntime_DirectML)\runtimes\win-x64\native\*.dll" />
      <_DirectMLNative Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_OnnxNative);@(_DirectMLNative)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_OnnxNative);@(_DirectMLNative)"
          DestinationFolder="$(OutDir)runtimes\win-x64\native"
          SkipUnchangedFiles="true" />
  </Target>

